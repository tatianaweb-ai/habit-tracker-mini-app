{
  "name": "habit-tracker-mini-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e.mjs",
    "check:render": "vite build --ssr checks/ssr.jsx --outDir .check --logLevel warn && node .check/ssr.js",
    "check": "npm run test && npm run check:render"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.2"
  }
}
